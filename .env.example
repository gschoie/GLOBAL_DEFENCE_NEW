# Gemini (무료 티어 가능) — 뉴스 채점·번역·요약에 필요
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# 뉴스 수집 파라미터
GOOGLE_NEWS_LOOKBACK=2d
MAX_ITEM_AGE_HOURS=48
MAX_ITEMS_TO_SCORE=80
MIN_RELEVANCE=4
MAX_ITEMS_PER_SECTION=15
DASHBOARD_WINDOW_HOURS=36
EXCLUDE_KOREAN_MEDIA=true
EXTRA_EXCLUDED_DOMAINS=

# 텔레그램 (나중 단계 — 기본 꺼짐)
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_ITEMS=20

# 유튜브 3일 모음 (youtube_digest.py) — @gs_analyst_bot 으로 발송
ENABLE_YT_TELEGRAM=true
YT_TELEGRAM_BOT_TOKEN=
YT_TELEGRAM_CHAT_ID=
YT_DIGEST_INTERVAL_DAYS=3
YT_MAX_PER_CHANNEL=20
PAGES_BASE_URL=https://gschoie.github.io/GLOBAL_DEFENCE_NEW
