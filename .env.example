# Gemini (무료 티어 가능) — 뉴스 채점·번역·요약에 필요
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# 뉴스 수집 파라미터
GOOGLE_NEWS_LOOKBACK=2d
MAX_ITEM_AGE_HOURS=48
MAX_ITEMS_TO_SCORE=80
MIN_RELEVANCE=4
MAX_ITEMS_PER_SECTION=15
DASHBOARD_WINDOW_HOURS=36
EXCLUDE_KOREAN_MEDIA=true
EXTRA_EXCLUDED_DOMAINS=

# 텔레그램 (나중 단계 — 기본 꺼짐)
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_ITEMS=20
